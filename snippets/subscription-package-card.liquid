{% liquid
  assign required = 0
  for step in package.steps.value
    assign required = required | plus: step.min_select.value
  endfor
  assign builder_url = builder_page.url
  if builder_url == blank
    assign builder_url = routes.root_url | append: 'pages/subscription-builder'
  endif
%}
<article class="subscription-card" data-order="{{ package.sort_order.value | default: 0 }}">
  {% if package.badge.value != blank %}<p class="subscription-badge">{{ package.badge.value | escape }}</p>{% endif %}
  {% if package.image.value != blank %}{{ package.image.value | image_url: width: 800 | image_tag: loading: 'lazy', alt: package.name.value }}{% endif %}
  <h2>{{ package.name.value | escape }}</h2>
  {% if package.description != blank %}{{ package.description | metafield_tag }}{% endif %}
  <p>{{ package.duration_months.value }} เดือน{% if package.delivery_interval.value != blank %} · จัดส่งทุก {{ package.delivery_interval.value }} เดือน{% endif %}{% if package.delivery_count.value != blank %} · รวม {{ package.delivery_count.value }} ครั้ง{% endif %}</p>
  <p>เลือกสินค้าอย่างน้อย {{ required }} ชิ้นต่อรอบ</p>
  {% if package.display_price.value != blank %}
    <p class="subscription-price">{{ package.display_price.value | times: 100 | money }} {% if package.compare_price.value > package.display_price.value %}<s>{{ package.compare_price.value | times: 100 | money }}</s>{% endif %}</p>
    <small>ราคาแพ็กเกจที่แสดง ราคาชำระจริงตามแผนสมาชิกในหน้าชำระเงิน</small>
  {% endif %}
  {% if package.discount_text.value != blank %}<p>{{ package.discount_text.value | escape }}</p>{% endif %}
  <a class="button" href="{{ builder_url }}?package={{ package.package_key.value | url_encode }}">เลือกแพ็กเกจนี้</a>
</article>
