<article class="subscription-card" data-product>
  {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}
  <h3>{{ product.title | escape }}</h3>
  {% for variant in product.variants %}
    {% liquid
      assign matching_plan = blank
      assign matches = 0
      for allocation in variant.selling_plan_allocations
        if allocation.selling_plan.name == step.selling_plan_name.value
          assign matching_plan = allocation.selling_plan.id
          assign matches = matches | plus: 1
        endif
      endfor
    %}
    <label class="subscription-option">
      <input type="checkbox" data-variant="{{ variant.id }}" data-product-id="{{ product.id }}" data-title="{{ product.title | escape }}{% unless product.has_only_default_variant %} — {{ variant.title | escape }}{% endunless %}" data-selling-plan="{{ matching_plan }}" {% unless variant.available and matches == 1 %}disabled data-ineligible{% endunless %}>
      <span>{% if product.has_only_default_variant %}เลือก {{ product.title | escape }}{% else %}{{ variant.title | escape }}{% endif %}{% unless variant.available %} — สินค้าหมด{% else %}{% unless matches == 1 %} — ไม่สามารถใช้สินค้านี้กับแพ็กเกจที่เลือกได้{% endunless %}{% endunless %}</span>
    </label>
  {% endfor %}
</article>
